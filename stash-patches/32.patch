--- a/scripts/automation/git-sync-safe.sh
+++ b/scripts/automation/git-sync-safe.sh
@@ -71,6 +71,16 @@ prune_repo_noise() {
     count=$((count + 1))
   done < <(find "$repo" -type f \( -name '.DS_Store' -o -name '*.orig' -o -name '*.rej' \) -print0)
 
+  while IFS= read -r -d '' path; do
+    [[ -n "$path" ]] || continue
+    rel="${path#$repo/}"
+    if git -C "$repo" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
+      continue
+    fi
+    rm -f "$path"
+    count=$((count + 1))
+  done < <(find "$repo" -maxdepth 1 -type f \( -name 'Swift-*.swiftmodule' -o -name 'Swift-*.swiftdoc' -o -name 'Swift-*.abi.json' \) -print0)
+
   if [[ "$count" -gt 0 ]]; then
     log "  - Pruned $count untracked noise file(s)"
   fi
