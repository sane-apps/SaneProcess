+
+  def normalized_config_content(dest_name, path)
+    content = File.read(path)
+    return normalize_gitignore_for_compare(content) if dest_name == '.gitignore'
+    return normalize_swiftlint_for_compare(content) if dest_name == '.swiftlint.yml'
+
+    content.strip
+  end
+
+  def normalize_gitignore_for_compare(content)
+    lines = content.lines(chomp: true)
+    normalized = []
+    inside_extension_block = false
+
+    lines.each do |line|
+      next if line == GITIGNORE_EXTENSION_HEADER || line == GITIGNORE_EXTENSION_NOTE
+
+      if line == GITIGNORE_EXTENSION_START
+        inside_extension_block = true
+        next
+      end
+
+      if line == GITIGNORE_EXTENSION_END
+        inside_extension_block = false
+        next
+      end
+
+      normalized << line unless inside_extension_block
+    end
+
+    normalized.join("\n").strip
+  end
+
+  def gitignore_extension_lines(content)
+    return [] if content.nil? || content.empty?
+
+    lines = content.lines(chomp: true)
+    start = lines.index(GITIGNORE_EXTENSION_START)
+    return [] unless start
+
+    finish_offset = lines[(start + 1)..]&.index(GITIGNORE_EXTENSION_END)
+    return [] unless finish_offset
+
+    lines[(start + 1)...(start + 1 + finish_offset)]
+  end
+
+  def merge_gitignore_template(template_content, project_content)
+    lines = template_content.lines(chomp: true)
+    start = lines.index(GITIGNORE_EXTENSION_START)
+    finish_offset = lines[(start + 1)..]&.index(GITIGNORE_EXTENSION_END) if start
+    return template_content unless start && finish_offset
+
+    merged = []
+    merged.concat(lines[0..start])
+    extension_lines = gitignore_extension_lines(project_content)
+    merged.concat(extension_lines) unless extension_lines.empty?
+    merged << GITIGNORE_EXTENSION_END
+    merged.concat(lines[(start + finish_offset + 2)..] || [])
+    merged.join("\n") + "\n"
+  end
+
+  def normalize_swiftlint_for_compare(content)
+    lines = content.lines(chomp: true)
+    normalized = []
+    inside_extension_block = false
+
+    lines.each do |line|
+      next if line == SWIFTLINT_EXTENSION_HEADER || line == SWIFTLINT_EXTENSION_NOTE
+
+      if line == SWIFTLINT_EXTENSION_START
+        inside_extension_block = true
+        next
+      end
+
+      if line == SWIFTLINT_EXTENSION_END
+        inside_extension_block = false
+        next
+      end
+
+      normalized << line unless inside_extension_block
+    end
+
+    normalized.join("\n").strip
+  end
+
+  def swiftlint_extension_lines(content)
+    return [] if content.nil? || content.empty?
+
+    lines = content.lines(chomp: true)
+    start = lines.index(SWIFTLINT_EXTENSION_START)
+    return [] unless start
+
+    finish_offset = lines[(start + 1)..]&.index(SWIFTLINT_EXTENSION_END)
+    return [] unless finish_offset
+
+    lines[(start + 1)...(start + 1 + finish_offset)]
+  end
+
+  def merge_swiftlint_template(template_content, project_content)
+    lines = template_content.lines(chomp: true)
+    start = lines.index(SWIFTLINT_EXTENSION_START)
+    finish_offset = lines[(start + 1)..]&.index(SWIFTLINT_EXTENSION_END) if start
+    return template_content unless start && finish_offset
+
+    merged = []
+    merged.concat(lines[0..start])
+    extension_lines = swiftlint_extension_lines(project_content)
+    merged.concat(extension_lines) unless extension_lines.empty?
+    merged << SWIFTLINT_EXTENSION_END
+    merged.concat(lines[(start + finish_offset + 2)..] || [])
+    merged.join("\n") + "\n"
+  end
