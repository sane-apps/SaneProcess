+print_github_json() {
+  local path="$1"
+  local kind="$2"
+
+  STATUS_GITHUB_LIMIT="$GITHUB_LIMIT" STATUS_GITHUB_PER_REPO_LIMIT="$GITHUB_PER_REPO_LIMIT" python3 - "$path" "$kind" <<'PY'
+import json
+import os
+import sys
+from collections import defaultdict
+
+path, kind = sys.argv[1], sys.argv[2]
+try:
+    with open(path, "r", encoding="utf-8") as handle:
+        rows = json.load(handle)
+except Exception as exc:
+    print(f"Unable to parse GitHub {kind} data: {exc}")
+    sys.exit(0)
+
+if kind == "issues":
+    rows = [row for row in rows if not row.get("isPullRequest")]
+
+groups = defaultdict(list)
+for row in rows:
+    repo_obj = row.get("repository") or {}
+    repo = repo_obj.get("nameWithOwner") or repo_obj.get("name") or "unknown"
+    groups[repo].append(row)
+
+label = "issues" if kind == "issues" else "PRs"
+if not rows:
+    print(f"No open GitHub {label} found.")
+    sys.exit(0)
+
+print(f"Open GitHub {label}: {len(rows)} across {len(groups)} repos")
+search_limit = int(os.environ.get("STATUS_GITHUB_LIMIT", "0") or "0")
+if search_limit > 0 and len(rows) >= search_limit:
+    print(f"WARNING: GitHub {label} reached the configured search limit ({search_limit}); raise STATUS_GITHUB_LIMIT and rerun.")
+
+per_repo_limit = int(os.environ.get("STATUS_GITHUB_PER_REPO_LIMIT", "20"))
+
+for repo in sorted(groups):
+    repo_rows = sorted(
+        groups[repo],
+        key=lambda row: row.get("updatedAt") or "",
+        reverse=True,
+    )
+    print("")
+    print(f"## {repo}")
+    for row in repo_rows[:per_repo_limit]:
+        updated = (row.get("updatedAt") or "").split("T", 1)[0]
+        number = row.get("number", "?")
+        title = row.get("title", "").strip()
+        url = row.get("url", "")
+        suffix = f" ({updated})" if updated else ""
+        print(f"- #{number} {title}{suffix}")
+        if url:
+            print(f"  {url}")
+    remaining = len(repo_rows) - per_repo_limit
+    if remaining > 0:
+        print(f"- ... {remaining} more not shown")
+PY
+}
