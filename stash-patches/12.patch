+def write_test_png(path, width: 512, height: 512)
+  signature = "\x89PNG\r\n\x1A\n".b
+  raw = String.new.b
+  height.times { raw << "\x00".b << ("\xFF\xFF\xFF\xFF".b * width) }
+
+  chunk = lambda do |type, data|
+    [data.bytesize].pack('N') + type + data + [Zlib.crc32(type + data)].pack('N')
+  end
+
+  File.binwrite(
+    path,
+    signature +
+      chunk.call('IHDR'.b, [width, height, 8, 6, 0, 0, 0].pack('NNCCCCC')) +
+      chunk.call('IDAT'.b, Zlib::Deflate.deflate(raw)) +
+      chunk.call('IEND'.b, ''.b)
+  )
+end
+
+def create_review_zip(zip_path, include_icon: true, icon_size: 512)
+  stage = File.join(File.dirname(zip_path), "stage-#{File.basename(zip_path, '.zip')}")
+  contents = File.join(stage, 'Test.app', 'Contents')
+  FileUtils.mkdir_p(contents)
+  File.write(File.join(contents, 'Info.plist'), <<~PLIST)
+    <?xml version="1.0" encoding="UTF-8"?>
+    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+    <plist version="1.0">
+    <dict>
+      <key>CFBundleIdentifier</key>
+      <string>com.example.test-setapp</string>
+      <key>CFBundleShortVersionString</key>
+      <string>1.2.3</string>
+      <key>CFBundleVersion</key>
+      <string>123</string>
+    </dict>
+    </plist>
+  PLIST
+  write_test_png(File.join(stage, 'AppIcon.png'), width: icon_size, height: icon_size) if include_icon
+  FileUtils.rm_f(zip_path)
+
+  Dir.chdir(stage) do
+    system('/usr/bin/zip', '-qry', zip_path, '.') || raise("zip failed for #{zip_path}")
+  end
+end
