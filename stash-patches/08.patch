+    route="${route%%#*}"
+    if [ -z "${route}" ] || [ "${route}" = "/" ]; then
+        return 0
+    fi
+
+    local route_no_slash="${route%/}"
+    local rel_path="${route#/}"
+    local rel_no_slash="${route_no_slash#/}"
