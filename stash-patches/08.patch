+
+    if [ -f "${deploy_dir}/_redirects" ]; then
+        if awk -v route="${route}" -v alt="${route_no_slash}/" 'NF >= 2 && ($1 == route || $1 == alt) { found = 1 } END { exit(found ? 0 : 1) }' "${deploy_dir}/_redirects"; then
