+def build_sop_csv_notes(score, violations, stats = nil)
+  stats ||= {}
+  violation_count = violations.is_a?(Hash) ? violations.values.sum : violations.to_i
+  verification = StateManager.get(:verification)
+  handoff = StateManager.get(:handoff_tracking)
+  skill = StateManager.get(:skill)
+  edits = stats[:edits] || StateManager.get(:edits)[:count] || 0
+  unique_files = stats[:unique_files] || StateManager.get(:edits)[:unique_files]&.length || 0
+
+  verify_note =
+    if edits.to_i.zero?
+      'n/a'
+    elsif verification[:tests_run] || verification[:verification_run]
+      'run'
+    elsif Array(StateManager.get(:edits)[:unique_files]).all? { |f| DOC_ONLY_EXTENSIONS.include?(File.extname(f.to_s).downcase) }
+      'doc-only'
+    else
+      'missing'
+    end
+
+  handoff_required = handoff[:always_persist_required] || handoff[:significant_edits].to_i >= 3
+  handoff_note =
+    if handoff_required
+      handoff[:handoff_updated] && handoff[:memory_updated] ? 'done' : 'missing'
+    else
+      'n/a'
+    end
+
+  skill_note =
+    if skill[:required]
+      "#{skill[:required]}:#{sop_skill_satisfied?(skill) ? 'done' : 'missing'}"
+    else
+      'n/a'
+    end
+
+  deductions =
+    case score.to_i
+    when 10 then 'none'
+    when 9 then 'minor-friction'
+    when 8 then 'moderate-friction'
+    when 7 then 'significant-friction'
+    when 6 then 'heavy-friction'
+    else 'excessive-friction'
+    end
+
+  [
+    "blocks=#{violation_count}",
+    "verify=#{verify_note}",
+    "research=#{stats[:research_done] || StateManager.get(:research).compact.keys.length}/4",
+    "edits=#{edits}/#{unique_files}",
+    "handoff=#{handoff_note}",
+    "skill=#{skill_note}",
+    "deductions=#{deductions}"
+  ].join(';')
+end
