+      setapp = config['setapp'].is_a?(Hash) ? config['setapp'] : {}
+      app_type = setapp['app_type'].to_s
+      if app_type == 'menu_bar' || blob.match?(/NSStatusItem|MenuBarExtra|statusItem/i)
+        if blob.match?(/userInteraction|STPUsageEventUserInteraction|reportUsageEvent/i)
+          puts '  │ Menu bar usage reporting... ✅'
+        else
+          puts '  │ Menu bar usage reporting... ❌'
+          issues << 'Menu bar Setapp app must report userInteraction usage events after real menu bar activation'
+        end
+      end
+
+      puts '  │ Privacy-sensitive APIs... ✅ reviewed as heuristic'
+    end
+
+    def setapp_artifact_strings(app_path)
+      paths = Dir.glob(File.join(app_path, 'Contents', '{MacOS,Frameworks,PlugIns,Resources}', '**', '*'), File::FNM_EXTGLOB)
+                 .select { |path| File.file?(path) && File.size(path) < 25_000_000 }
+      strings = +''
+      paths.each do |path|
+        out, = Open3.capture2e('strings', '-a', path.to_s)
+        strings << out
+        strings << "\n"
+      end
+      strings
+    rescue StandardError
+      ''
+    end
