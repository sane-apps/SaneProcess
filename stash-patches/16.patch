+      issues[:advisory] << {
+        file: relative_path,
+        kind: 'duplicate-block',
+        message: "repeated #{SLOP_DUPLICATE_WINDOW_LINES}-line block at lines #{duplicate[:first_line]} and #{duplicate[:second_line]}"
+      }
+    end
+
+    def scan_slop_source_shape_tests(relative_path, content, issues)
+      return unless relative_path.match?(/test/i)
+
+      source_reads = content.scan(/\b(?:String\s*\(\s*contentsOf:|File\.read\s*\()/).count
+      contains_assertions = content.scan(/\b(?:source|content|text|script|plist|pbxproj|manifest)\.contains\s*\(/).count
+      multiline_contains = content.scan(/\.contains\s*\([^)]*\\n/m).count
+      return if source_reads.zero? || contains_assertions.zero?
+
+      if contains_assertions >= SLOP_BRITTLE_SOURCE_HARD
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'brittle-source-test',
+          message: "#{contains_assertions} source-shape assertions; convert the highest-value ones to behavior tests"
+        }
+      elsif contains_assertions >= SLOP_BRITTLE_SOURCE_WARN
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'brittle-source-test',
+          message: "#{contains_assertions} source-shape assertions; this is starting to drift from behavior coverage"
+        }
+      end
+
+      return unless multiline_contains >= 2
+
+      issues[:advisory] << {
+        file: relative_path,
+        kind: 'whitespace-sensitive-source-test',
+        message: "#{multiline_contains} multiline source-string assertions depend on formatting"
+      }
+    end
