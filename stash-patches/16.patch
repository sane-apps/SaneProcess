+    def setapp_capture2e_with_timeout(*command, timeout_seconds:)
+      output = +''
+      status = nil
+      Open3.popen3(*command) do |stdin, stdout, stderr, wait_thr|
+        stdin.close
+        readers = [stdout, stderr].map do |stream|
+          Thread.new do
+            begin
+              stream.each_line { |line| output << line }
+            rescue IOError
+              nil
+            end
+          end
+        end
+
+        if wait_thr.join(timeout_seconds)
+          status = wait_thr.value
+        else
+          output << "\nTimed out after #{timeout_seconds}s: #{command.join(' ')}\n"
+          begin
+            Process.kill('TERM', wait_thr.pid)
+          rescue Errno::ESRCH
+            nil
+          end
+          sleep 1
+          begin
+            Process.kill('KILL', wait_thr.pid)
+          rescue Errno::ESRCH
+            nil
+          end
+          status = Struct.new(:success?) do
+            def exitstatus
+              nil
+            end
+          end.new(false)
+        end
+        readers.each { |reader| reader.join(1) }
+      end
+      [output, status]
+    end
