+    def setapp_resolve_artifact(artifact, tmpdir)
+      issues = []
+      warnings = []
+
+      if File.extname(artifact).downcase == '.zip'
+        out, status = Open3.capture2e('/usr/bin/ditto', '-x', '-k', artifact, tmpdir)
+        unless status.success?
+          issues << "Archive could not be extracted with ditto: #{summarized_output_tail(out)}"
+          return { app_path: nil, adjacent_dir: nil, issues: issues, warnings: warnings }
+        end
+
+        entries = Dir.children(tmpdir)
+        issues << 'Archive contains __MACOSX metadata; recreate it with ditto, not Finder compression' if entries.include?('__MACOSX')
+        app_paths = Dir.glob(File.join(tmpdir, '**', '*.app')).select { |path| File.directory?(path) }
+        upload_app_paths = app_paths.select do |path|
+          path.delete_prefix(tmpdir).sub(%r{\A/}, '').split(File::SEPARATOR).length <= 2
+        end
+        if upload_app_paths.length != 1
+          issues << "Archive must contain exactly one upload .app bundle at root or one directory deep; found #{upload_app_paths.length}"
+          fallback_app = upload_app_paths.first || app_paths.first
+          return { app_path: fallback_app, adjacent_dir: fallback_app && File.dirname(fallback_app), issues: issues, warnings: warnings }
+        end
+
+        app_path = upload_app_paths.first
+        adjacent_dir = File.dirname(app_path)
+        relative = app_path.delete_prefix(tmpdir).sub(%r{\A/}, '')
+        unless relative.split(File::SEPARATOR).length <= 2
+          issues << "Archive app must be at root or one directory deep; found #{relative}"
+        end
+
+        root_entries = entries.reject { |entry| entry == '__MACOSX' }
+        top = relative.split(File::SEPARATOR).first
+        unless root_entries.all? { |entry| entry == top || entry == File.basename(app_path) || entry.end_with?('.png') }
+          issues << "Archive has extra top-level entries: #{root_entries.join(', ')}"
+        end
+
+        { app_path: app_path, adjacent_dir: adjacent_dir, issues: issues, warnings: warnings }
+      elsif File.extname(artifact).downcase == '.app' && File.directory?(artifact)
+        { app_path: artifact, adjacent_dir: File.dirname(artifact), issues: issues, warnings: warnings }
+      else
+        issues << 'Artifact must be a .zip archive or .app bundle'
+        { app_path: nil, adjacent_dir: nil, issues: issues, warnings: warnings }
+      end
+    end
