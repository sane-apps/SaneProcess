+    def setapp_policy_endpoint_report(label, value)
+      text = value.to_s.strip
+      return { ok: false, message: "Missing Setapp #{label}" } if text.empty?
+      if text.match?(/\A[^@\s]+@[^@\s]+\.[^@\s]+\z/)
+        return { ok: true, message: "#{label}: #{text}" } if label == 'support URL/email'
+
+        return { ok: false, message: "Setapp #{label} must be a published URL, not an email address" }
+      end
+
+      health = appstore_url_health(text)
+      if health[:ok]
+        { ok: true, message: "#{label}: #{text}" }
+      else
+        { ok: false, message: "Setapp #{label} is not reachable: #{text} (#{health[:error] || health[:code]})" }
+      end
+    end
