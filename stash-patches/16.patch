+    def print_slop_report(report, verbose:)
+      if report[:blocking_count].zero? && report[:advisory_count].zero?
+        puts '   ✅ No high-confidence slop markers detected'
+        puts ''
+        return
+      end
+
+      if verbose
+        if report[:issues][:blocking].any?
+          puts '❌ BLOCKING ISSUES:'
+          report[:issues][:blocking].each do |issue|
+            location = issue[:line] ? "#{issue[:file]}:#{issue[:line]}" : issue[:file]
+            puts "   • #{location} — #{issue[:kind]}: #{issue[:message]}"
+          end
+          puts ''
+        end
+
+        if report[:issues][:advisory].any?
+          puts '⚠️  ADVISORY ISSUES:'
+          report[:issues][:advisory].each do |issue|
+            puts "   • #{issue[:file]} — #{issue[:kind]}: #{issue[:message]}"
+          end
+          puts ''
+        end
+      else
+        puts "   ❌ #{report[:blocking_count]} blocking slop issue(s)" if report[:blocking_count].positive?
+        report[:issues][:blocking].group_by { |issue| issue[:file] }.each do |file, grouped|
+          kinds = grouped.map { |issue| issue[:kind] }.uniq.join(', ')
+          puts "      ⚠️  #{file}: #{kinds}"
+        end
+        puts "   ⚠️  #{report[:advisory_count]} advisory slop issue(s)" if report[:advisory_count].positive?
+      end
+
+      puts ''
+    end
