+    def slop_candidate_files(target_root)
+      files = Dir.glob(File.join(target_root, '**', '*.{swift,rb,py,sh}'), File::FNM_EXTGLOB)
+      files.reject do |path|
+        next true unless File.file?(path)
+
+        relative = path.sub(%r{^#{Regexp.escape(target_root)}/?}, '')
+        slop_ignored_path?(relative) || slop_generated_file?(relative)
+      end.sort
+    end
+
+    def slop_ignored_path?(relative_path)
+      ignored_fragments = %w[
+        /.git/
+        /.build/
+        /.worktrees/
+        /DerivedData/
+        /build/
+        /Pods/
+        /Carthage/
+        /vendor/
+        /archives/
+        /node_modules/
+        /coverage/
+        /outputs/
+      ]
+      ignored_fragments.any? { |fragment| relative_path.include?(fragment.delete_prefix('/')) || relative_path.include?(fragment) }
+    end
+
+    def slop_generated_file?(relative_path)
+      relative_path.include?('Mocks.swift') ||
+        relative_path.include?('.generated.') ||
+        relative_path.include?('/Generated/')
+    end
+
+    def scan_slop_file_length(relative_path, content, issues)
+      line_count = content.lines.count
+      if line_count > SWIFT_FILE_HARD_LIMIT
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'oversized-file',
+          message: "#{line_count} lines; split this file before release"
+        }
+      elsif line_count > SWIFT_FILE_SOFT_LIMIT
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'large-file',
+          message: "#{line_count} lines; approaching hard-to-audit size"
+        }
+      end
+    end
+
+    def scan_slop_deep_nesting(relative_path, content, ext, issues)
+      return unless ext == '.swift'
+
+      max_depth = slop_max_brace_depth(content, ext)
+      if max_depth >= SLOP_NESTING_HARD
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'deep-nesting',
+          message: "maximum nesting depth #{max_depth}; flatten control flow"
+        }
+      elsif max_depth >= SLOP_NESTING_WARN
+        issues[:advisory] << {
+          file: relative_path,
+          kind: 'deep-nesting',
+          message: "maximum nesting depth #{max_depth}; readability is drifting"
+        }
+      end
+    end
+
+    def scan_slop_duplicate_blocks(relative_path, content, ext, issues)
+      duplicate = slop_duplicate_block(content, ext)
