+    def setapp_audit_app_bundle(app_path, adjacent_dir:, config:, issues:, warnings:)
+      app_name = File.basename(app_path, '.app')
+      info_path = File.join(app_path, 'Contents', 'Info.plist')
+      info = plist_file_to_hash(info_path)
+
+      puts '  ┌── macOS Bundle Requirements ──'
+      print '  Bundle Info.plist... '
+      missing_keys = SETAPP_REQUIRED_INFO_KEYS.reject { |key| info.key?(key) && !info[key].to_s.strip.empty? }
+      if missing_keys.empty?
+        puts '✅'
+      else
+        puts '❌'
+        issues << "Info.plist missing Setapp-required key(s): #{missing_keys.join(', ')}"
+      end
+
+      bundle_id = info['CFBundleIdentifier'].to_s
+      setapp = config['setapp'].is_a?(Hash) ? config['setapp'] : {}
+      expected_bundle_id = metadata_value(setapp, 'bundle_id').to_s
+      if !expected_bundle_id.empty? && bundle_id != expected_bundle_id
+        issues << "Setapp bundle ID must match .saneprocess exactly: expected #{expected_bundle_id}, found #{bundle_id}"
+      end
+      issues << "Bundle ID must use Setapp lane suffix (-setapp); found #{bundle_id}" unless bundle_id.end_with?('-setapp')
+      unless bundle_id.match?(/\A[A-Za-z0-9.-]+-setapp\z/)
+        issues << "Setapp bundle ID must be reverse-DNS-safe with ASCII letters, digits, periods, and hyphen-minus only; found #{bundle_id}"
+      end
+
+      forbidden_keys = SETAPP_FORBIDDEN_INFO_KEYS.select { |key| info.key?(key) }
+      issues << "Setapp build must not include direct/App Store updater or purchase key(s): #{forbidden_keys.join(', ')}" if forbidden_keys.any?
+
+      update_policy = info['NSUpdateSecurityPolicy'].is_a?(Hash) ? info['NSUpdateSecurityPolicy'] : {}
+      allowed = update_policy.dig('AllowProcesses', SETAPP_AGENT_TEAM_ID)
