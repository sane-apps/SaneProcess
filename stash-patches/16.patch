+      out, _status = Open3.capture2e('otool', '-L', executable)
+      needs_sparkle = out.include?('Sparkle.framework')
+      sparkle_path = File.join(app_path, 'Contents', 'Frameworks', 'Sparkle.framework')
+      if needs_sparkle && !File.directory?(sparkle_path)
+        puts '❌'
+        issues << 'Main executable links Sparkle.framework, but Contents/Frameworks/Sparkle.framework is missing'
+      elsif needs_sparkle && !setapp_exception_documented?(config.fetch('setapp', {}), 'retained_sparkle_framework')
