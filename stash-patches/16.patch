+    def setapp_wait_for_runtime_proof(proof_path, timeout_seconds: 20)
+      deadline = Time.now + timeout_seconds
+      last_proof = nil
+      until Time.now >= deadline
+        if File.exist?(proof_path)
+          last_proof = JSON.parse(File.read(proof_path))
+          return last_proof if setapp_runtime_proof_valid?(last_proof['app'].to_s, last_proof)
+        end
+        sleep 0.25
+      end
+      last_proof
+    rescue JSON::ParserError
+      { '_parse_error' => true, 'path' => proof_path }
+    end
+
+    def setapp_runtime_proof_valid?(app_name, proof)
+      return false unless proof.is_a?(Hash)
+
+      case app_name
+      when 'SaneClip'
+        proof['app'] == 'SaneClip' &&
+          proof['settingsVisible'] == true &&
+          proof['settingsTitle'].to_s.include?('SaneClip Settings')
+      when 'SaneBar'
+        proof['app'] == 'SaneBar' &&
+          proof['settingsVisible'] == true &&
+          proof['settingsTitle'].to_s.include?('SaneBar Settings') &&
+          proof['iconPanelVisible'] == true &&
+          proof['iconPanelMode'] == 'findIcon'
+      else
+        proof['app'] == app_name
+      end
+    end
+
+    def setapp_runtime_proof_failure(app_name, proof, proof_path)
+      return "proof receipt was not written within 20s at #{proof_path}" if proof.nil?
+      return "proof receipt was not valid JSON at #{proof_path}" if proof['_parse_error']
+
+      "unexpected proof receipt for #{app_name}: #{proof.inspect}"
+    end
+
+    def setapp_wait_for_process(app_name, app_path, timeout_seconds: 12)
+      deadline = Time.now + timeout_seconds
+      expected_executable = File.join(app_path, 'Contents', 'MacOS', app_name)
+      while Time.now < deadline
+        out, = Open3.capture2e('ps', '-axo', 'pid=,command=')
+        return true if out.lines.any? { |line| line.include?(expected_executable) }
+
+        sleep 1
+      end
+      false
+    end
