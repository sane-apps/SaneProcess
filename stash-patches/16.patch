+    def scan_slop_ai_artifact_comments(relative_path, content, ext, issues)
+      markers = [
+        /ai can read/i,
+        /generated by (?:ai|chatgpt|claude|copilot)/i,
+        /copied from (?:chatgpt|claude|copilot)/i
+      ]
+
+      content.lines.each_with_index do |line, idx|
+        comment = slop_comment_text(line, ext)
+        next unless comment
+
+        marker = markers.find { |pattern| comment.match?(pattern) }
+        next unless marker
+
+        issues[:blocking] << {
+          file: relative_path,
+          line: idx + 1,
+          kind: 'ai-artifact-comment',
+          message: "comment includes '#{comment.strip}'"
+        }
+      end
+    end
+
+    def slop_comment_text(line, ext)
+      case ext
+      when '.swift'
+        line[%r{//(.*)$}, 1]
+      when '.rb', '.py', '.sh'
+        line[/#(.*)$/, 1]
+      else
+        nil
+      end
+    end
+
+    def slop_max_brace_depth(content, ext)
+      depth = 0
+      max_depth = 0
+      content.each_line do |line|
+        stripped = slop_strip_strings_and_comments(line, ext)
+        stripped.each_char do |char|
+          if char == '}'
+            depth = [depth - 1, 0].max
+          elsif char == '{'
+            depth += 1
+            max_depth = [max_depth, depth].max
+          end
+        end
+      end
+      max_depth
+    end
+
+    def slop_duplicate_block(content, ext)
+      normalized_lines = content.lines.each_with_index.map do |line, idx|
+        normalized = slop_normalized_line(line, ext)
+        next if normalized.empty?
+
+        { line: idx + 1, text: normalized }
+      end.compact
+      return nil if normalized_lines.length < SLOP_DUPLICATE_WINDOW_LINES * 2
+
+      windows = Hash.new { |hash, key| hash[key] = [] }
+      normalized_lines.each_cons(SLOP_DUPLICATE_WINDOW_LINES) do |window|
+        next if slop_window_trivial?(window)
+
+        block_text = window.map { |entry| entry[:text] }.join("\n")
+        next if block_text.length < 240
+
+        windows[block_text] << window.first[:line]
+      end
+
+      block_text, starts = windows.find do |_text, line_numbers|
+        line_numbers.length > 1 && line_numbers.each_cons(2).any? { |first, second| (second - first) >= SLOP_DUPLICATE_WINDOW_LINES }
+      end
+      return nil unless block_text && starts
+
+      { first_line: starts[0], second_line: starts[1], block: block_text }
+    end
+
+    def slop_window_trivial?(window)
+      trivial = window.count do |entry|
+        entry[:text].match?(/\A(?:[\{\}\[\]\(\),]+|else|do|end)\z/)
+      end
+      trivial >= (SLOP_DUPLICATE_WINDOW_LINES / 2)
+    end
+
+    def slop_normalized_line(line, ext)
+      stripped = slop_strip_strings_and_comments(line, ext)
+      normalized = stripped.strip.gsub(/\s+/, ' ')
+      return '' if normalized.empty?
+      return '' if normalized.start_with?('import ')
+
+      normalized
+    end
+
+    def slop_strip_strings_and_comments(line, ext)
+      without_strings = line.gsub(/"(?:\\.|[^"\\])*"/, '""')
+      case ext
+      when '.swift'
+        without_strings.sub(%r{//.*$}, '')
+      when '.rb', '.py', '.sh'
+        without_strings.sub(/#.*$/, '')
+      else
+        without_strings
+      end
+    end
