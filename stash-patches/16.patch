+      unless status.success?
+        puts '❌ unreadable'
+        issues << 'Could not inspect main executable architectures with lipo'
+        return
+      end
+
+      actual = out.split(/\s+/).reject(&:empty?)
+      missing = Array(declared_architectures).map(&:to_s) - actual
+      if missing.any?
+        puts '❌'
+        issues << "MPSupportedArchitectures declares #{missing.join(', ')} but main executable has #{actual.join(', ')}"
+      elsif actual.include?('arm64') && actual.include?('x86_64')
+        puts '✅ universal'
+      else
+        puts "❌ #{actual.join(', ')}"
