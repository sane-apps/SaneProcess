+      end
+    end
+
+    def setapp_audit_signing(app_path, issues)
+      print '  Code signing and notarization... '
+      out, status = Open3.capture2e('codesign', '--verify', '--deep', '--strict', '--verbose=2', app_path.to_s)
+      unless status.success?
+        puts '❌'
+        issues << "codesign verification failed: #{summarized_output_tail(out)}"
+        return
+      end
+
+      out, status = Open3.capture2e('spctl', '--assess', '--type', 'execute', '--verbose=4', app_path.to_s)
+      if status.success?
+        puts '✅'
+      else
+        puts '❌'
+        issues << "Gatekeeper assessment failed: #{summarized_output_tail(out)}"
+      end
+    end
