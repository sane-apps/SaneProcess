+    def setapp_audit_forbidden_functionality(app_path, config, issues, warnings)
+      puts '  ┌── Review Guideline Heuristics ──'
+      blob = setapp_artifact_strings(app_path)
+
+      high_confidence_hits = []
+      SETAPP_FORBIDDEN_ARTIFACT_PATTERNS.each do |label, pattern|
+        high_confidence_hits << label if blob.match?(pattern)
+      end
+      if high_confidence_hits.empty?
+        puts '  │ Forbidden purchase/update/rating markers... ✅'
+      else
+        puts '  │ Forbidden purchase/update/rating markers... ❌'
+        high_confidence_hits.each { |hit| issues << "Setapp artifact appears to include forbidden functionality marker: #{hit}" }
+      end
+
+      review_hits = SETAPP_REVIEW_WARNING_PATTERNS.keys.select { |label| blob.match?(SETAPP_REVIEW_WARNING_PATTERNS[label]) }
+      setapp = config['setapp'].is_a?(Hash) ? config['setapp'] : {}
+      review_hits.each do |hit|
+        exception_key = hit == 'direct license-key copy' ? 'license_strings_unreachable' : 'retained_sparkle_framework'
+        unless setapp_exception_documented?(setapp, exception_key)
+          issues << "Artifact contains #{hit}; add documented_exceptions.#{exception_key} only after verifying the Setapp channel hides/removes that functionality at runtime"
+        end
+      end
+
+      login_item_hit = blob.match?(/SMLoginItemSetEnabled|LaunchAgent|Login Item/i)
+      if login_item_hit
