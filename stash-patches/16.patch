+    def setapp_audit_icons(app_path, adjacent_dir, app_name, info, issues, warnings)
+      icon_candidates = [
+        File.join(adjacent_dir, 'AppIcon.png'),
+        File.join(adjacent_dir, "#{app_name}.png")
+      ].uniq
+      adjacent_icon = icon_candidates.find { |path| File.file?(path) }
+      if adjacent_icon
+        width, height = setapp_image_dimensions(adjacent_icon)
+        if width.to_i >= SETAPP_REQUIRED_ICON_SIZE && height.to_i >= SETAPP_REQUIRED_ICON_SIZE
+          puts "  Adjacent PNG icon... ✅ #{File.basename(adjacent_icon)} #{width}x#{height}"
+        else
+          puts '  Adjacent PNG icon... ❌'
+          issues << "Adjacent Setapp PNG icon must be at least #{SETAPP_REQUIRED_ICON_SIZE}x#{SETAPP_REQUIRED_ICON_SIZE}; found #{width || '?'}x#{height || '?'}"
+        end
+      else
+        puts '  Adjacent PNG icon... ❌'
+        issues << "Archive must include AppIcon.png or #{app_name}.png next to #{app_name}.app"
+      end
+
+      icon_file = info['CFBundleIconFile'].to_s
+      icon_file = 'AppIcon' if icon_file.strip.empty?
+      icon_file += '.icns' unless File.extname(icon_file) == '.icns'
+      icon_path = File.join(app_path, 'Contents', 'Resources', icon_file)
+      unless File.file?(icon_path)
+        issues << "CFBundleIconFile points to #{icon_file}, but the file was not found in Contents/Resources"
+        return
+      end
+
+      width, height = setapp_image_dimensions(icon_path)
+      if width.to_i < SETAPP_REQUIRED_ICON_SIZE || height.to_i < SETAPP_REQUIRED_ICON_SIZE
+        issues << "Bundle ICNS specified by CFBundleIconFile must include at least #{SETAPP_REQUIRED_ICON_SIZE}px artwork; sips reported #{width || '?'}x#{height || '?'}"
+      end
+    end
+
+    def setapp_image_dimensions(path)
+      return setapp_icns_dimensions(path) if File.extname(path.to_s).casecmp('.icns').zero?
+
+      out, status = Open3.capture2e('sips', '-g', 'pixelWidth', '-g', 'pixelHeight', path.to_s)
+      return [nil, nil] unless status.success?
+
+      [out[/pixelWidth:\s*(\d+)/, 1]&.to_i, out[/pixelHeight:\s*(\d+)/, 1]&.to_i]
+    rescue StandardError
+      [nil, nil]
+    end
+
+    def setapp_icns_dimensions(path)
+      Dir.mktmpdir('setapp-icns-') do |dir|
+        iconset = File.join(dir, 'AppIcon.iconset')
+        _out, status = Open3.capture2e('iconutil', '-c', 'iconset', '-o', iconset, path.to_s)
+        return setapp_sips_dimensions(path) unless status.success?
+
+        dimensions = Dir.glob(File.join(iconset, '*.png')).map do |png|
+          width, height = setapp_sips_dimensions(png)
+          width && height ? [width, height] : nil
+        end.compact
+        return setapp_sips_dimensions(path) if dimensions.empty?
+
+        [dimensions.map(&:first).max, dimensions.map(&:last).max]
+      end
+    rescue StandardError
+      setapp_sips_dimensions(path)
+    end
+
+    def setapp_sips_dimensions(path)
+      out, status = Open3.capture2e('sips', '-g', 'pixelWidth', '-g', 'pixelHeight', path.to_s)
+      return [nil, nil] unless status.success?
+
+      [out[/pixelWidth:\s*(\d+)/, 1]&.to_i, out[/pixelHeight:\s*(\d+)/, 1]&.to_i]
+    rescue StandardError
+      [nil, nil]
+    end
+
+    def setapp_audit_public_key(app_path, issues)
+      print '  Setapp public key... '
+      exact_path = File.join(app_path, 'Contents', 'Resources', 'setappPublicKey.pem')
+      setapp = setapp_project_config.fetch('setapp', {})
+      expected_sha = setapp['public_key_sha256'].to_s.strip
+      actual_sha = File.file?(exact_path) ? OpenSSL::Digest::SHA256.file(exact_path).hexdigest : ''
+      if File.file?(exact_path) && !expected_sha.empty? && actual_sha == expected_sha
+        puts '✅'
+      elsif File.file?(exact_path) && expected_sha.empty?
+        puts '❌'
+        issues << 'Setapp public_key_sha256 must be recorded in .saneprocess so the app/platform public key is verified, not merely present'
+      elsif File.file?(exact_path)
+        puts '❌'
+        issues << "Setapp public key SHA-256 mismatch: expected #{expected_sha}, found #{actual_sha}"
+      else
+        puts '❌'
+        candidates = Dir.glob(File.join(app_path, 'Contents', 'Resources', '**', '*setappPublicKey*.pem'), File::FNM_CASEFOLD)
+        suffix = candidates.empty? ? '' : " (found non-exact candidate(s): #{candidates.map { |path| path.sub("#{app_path}/Contents/Resources/", '') }.join(', ')})"
+        issues << "Setapp public key resource must be named exactly Contents/Resources/setappPublicKey.pem#{suffix}"
+      end
+    end
+
+    def setapp_audit_nested_bundle_ids(app_path, parent_bundle_id, issues)
+      nested_plists = Dir.glob(File.join(app_path, 'Contents', '{Frameworks,PlugIns,Library}', '**', 'Info.plist'), File::FNM_EXTGLOB)
+      bad = nested_plists.each_with_object([]) do |plist_path, acc|
+        info = plist_file_to_hash(plist_path)
+        nested_id = info['CFBundleIdentifier'].to_s
+        next if nested_id.empty?
+        next if nested_id.start_with?("#{parent_bundle_id}.")
+        next if nested_id.start_with?('com.apple.')
+        next if nested_id.match?(/\A(?:org|com)\.(?:sparkle-project|macpaw|setapp)\b/i)
+
+        acc << "#{nested_id} (#{plist_path.sub("#{app_path}/", '')})"
+      end
+      issues << "Nested executable/helper bundle IDs must follow #{parent_bundle_id}.<name>: #{bad.join(', ')}" if bad.any?
+    end
+
+    def setapp_audit_framework_integration(app_path, issues)
+      print '  Setapp framework integration... '
+      blob = setapp_artifact_strings(app_path)
+      debug_dylibs = Dir.glob(File.join(app_path, 'Contents', '**', 'debug.dylib'), File::FNM_CASEFOLD)
+      missing_scv = !blob.match?(/__scv__\d+(?:\.\d+)*/)
+
+      if missing_scv || debug_dylibs.any?
+        puts '❌'
+        issues << 'Setapp Framework version symbol (__scv__) is missing from the app artifact' if missing_scv
+        if debug_dylibs.any?
+          issues << "Setapp artifact must not include debug.dylib: #{debug_dylibs.map { |path| path.sub("#{app_path}/", '') }.join(', ')}"
+        end
+      else
+        puts '✅'
+      end
+    end
+
+    def setapp_entitlements(app_path)
+      out, status = Open3.capture2e('codesign', '-d', '--entitlements', ':-', app_path.to_s)
+      return {} unless status.success? || out.include?('<plist')
+
+      plist = out[out.index('<plist')..] || out[out.index('<?xml')..] || ''
+      return {} if plist.strip.empty?
+
+      Tempfile.create(['setapp-entitlements', '.plist']) do |file|
+        file.write(plist)
+        file.flush
+        return plist_file_to_hash(file.path)
+      end
+    rescue StandardError
+      {}
+    end
+
+    def setapp_audit_entitlements(app_path, issues)
+      print '  Sandbox entitlements... '
+      entitlements = setapp_entitlements(app_path)
+      if entitlements.empty?
+        puts '⚠️  unreadable'
+        return
+      end
+
+      puts '✅'
