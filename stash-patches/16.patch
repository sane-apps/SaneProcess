+    def setapp_probe_artifact_navigation(app_name, proof_path, issues)
+      print '  Navigation smoke... '
+      proof = setapp_wait_for_runtime_proof(proof_path)
+      if setapp_runtime_proof_valid?(app_name, proof)
+        puts '✅'
