 mkdir -p "$HOME/Library/LaunchAgents" "$OUTPUT_DIR"
 
+bootstrap_agent() {
+  local label="$1"
+  local plist="$2"
+  local domain="gui/$(id -u)"
+
+  launchctl bootout "$domain/$label" 2>/dev/null || true
+  launchctl bootout "$domain" "$plist" 2>/dev/null || true
