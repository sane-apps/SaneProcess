-    /SaneMaster\.rb\s+saneloop/,
-    /SaneMaster\.rb\s+verify/,
-    /verify\.rb/
-  ].freeze
-
-  RESEARCH_TOOLS = %w[
-    Read Glob Grep WebSearch WebFetch Task
-    mcp__apple-docs__ mcp__context7__ mcp__github__
