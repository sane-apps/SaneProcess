-    StateManager.update(:enforcement) do |e|
-      signature = "#{result.rule}:#{result.detector_name}"
-
-      # Add this block to history (use string keys for JSON compatibility)
-      e[:blocks] ||= []
-      e[:blocks] << { 'signature' => signature, 'at' => Time.now.iso8601 }
