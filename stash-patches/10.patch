+    def settings_ui_content?(content)
+      content.match?(/Settings\s*\{/) ||
+        content.match?(/^\s*struct\s+\w*Settings\w*\s*:\s*View\b/m) ||
+        content.match?(/^\s*struct\s+SettingsView\s*:\s*View\b/m) ||
+        content.include?('SaneSettingsContainer(')
+    end
+
+    def permission_guidance_content?(content)
+      content.match?(/PermissionPrompt\w*\s*:\s*View/) ||
+        (content.match?(/^\s*struct\s+\w+\s*:\s*View\b/m) &&
+          (
+            content.match?(/\b(permission|denied)\b/i) &&
+              content.match?(/Accessibility|Automation|Screen Recording|ScreenCapture|Microphone|Camera|Photos|Files and Folders|Full Disk Access|Login Items|Privacy_(?:Accessibility|Automation|ScreenCapture|Microphone|Camera|Photos|FilesAndFolders|AllFiles)/i)
+          ))
+    end
+
+    def menu_surface_file?(content)
+      MENU_SURFACE_MATCHERS.any? { |pattern| content.match?(pattern) }
+    end
+
+    def shared_standard_menu_usage?(content)
+      content.include?('SaneStandardMenu.')
+    end
+
+    def direct_sparkle_app?(contents, metadata)
+      source = contents.values.join("\n")
+      has_sparkle_runtime = source.match?(/SPUStandardUpdaterController|SPUUpdater|import\s+Sparkle/)
+      has_update_surface = source.match?(/SaneSparkleRow\(|checkForUpdates/) || metadata.include?('SUFeedURL')
+      has_sparkle_runtime && has_update_surface
+    end
+
+    def privacy_metadata_content(root)
+      Dir.glob(File.join(root, '**', '*.{plist,yml,yaml}')).reject do |file|
+        file.include?('/.build/') ||
+          file.include?('/build/') ||
+          file.include?('/DerivedData/') ||
+          file.include?('/SourcePackages/') ||
+          file.include?('/Packages/')
+      end.map { |file| File.read(file) }.join("\n")
+    end
+
+    def privacy_usage_findings(contents, metadata)
+      source = contents.values.join("\n")
+      checks = [
+        {
+          label: 'Microphone usage without Info.plist purpose string',
+          api_patterns: [
+            /AVAudioApplication\.requestRecordPermission/,
+            /AVCaptureDevice\.requestAccess\s*\(\s*for:\s*\.audio/,
+            /AVAudioRecorder\b/
+          ],
+          required_keys: ['NSMicrophoneUsageDescription'],
+          fix: 'Add NSMicrophoneUsageDescription with a concrete user-facing reason for audio recording.'
+        },
+        {
+          label: 'Apple Events automation without Info.plist purpose string',
+          api_patterns: [
+            /NSAppleScript\b/,
+            /osascript/,
+            /AppleScriptRunner/,
+            /NSAppleEventsUsageDescription/
+          ],
+          required_keys: ['NSAppleEventsUsageDescription'],
+          fix: 'Add NSAppleEventsUsageDescription explaining which apps the app controls and why.'
+        },
+        {
+          label: 'Photos access without Info.plist purpose string',
+          api_patterns: [
+            /PHPhotoLibrary\b/,
+            /PhotosUI\b/,
+            /tell application "Photos"/,
+            /targetHint:\s*"Photos"/,
+            /importToPhotos/
+          ],
+          required_keys: ['NSPhotoLibraryUsageDescription', 'NSPhotoLibraryAddUsageDescription'],
+          fix: 'Add NSPhotoLibraryUsageDescription or NSPhotoLibraryAddUsageDescription for Photos import/access.'
+        }
+      ]
+
+      checks.each_with_object([]) do |check, findings|
+        next unless check[:api_patterns].any? { |pattern| source.match?(pattern) }
+        next if check[:required_keys].any? { |key| metadata.include?(key) }
+
+        findings << Finding.new(
+          severity: :error,
+          label: check[:label],
+          detail: check[:required_keys].join(' or '),
+          fix: check[:fix]
+        )
+      end
+    end
+
     def relative_path(root, file)
       file.delete_prefix("#{root}/")
     end
