+  if version.to_s.strip.empty?
+    puts "- #{app_name}: appstore enabled, but current MARKETING_VERSION could not be determined"
+    next
+  end
+
+  platforms = Array(appstore['platforms'] || ['macos']).map(&:to_s)
+  app_id = appstore['app_id'].to_s
+  platform_summaries = []
+
+  platforms.each do |platform|
+    report = sm.send(:asc_version_lane_guardrail_report, app_id: app_id, platform: platform, version_string: version)
+    summary = report[:summary].to_s.strip
+    state = report[:target_state].to_s.strip
+    if state == 'PENDING_DEVELOPER_RELEASE'
+      platform_summaries << "#{platform}=#{summary} ACTION: release manually"
+    elsif summary.empty?
+      platform_summaries << "#{platform}=unavailable"
+    else
+      platform_summaries << "#{platform}=#{summary}"
+    end
+  end
+
+  puts "- #{app_name} #{version}: #{platform_summaries.join(' | ')}"
+end
+
+puts "No appstore-enabled app manifests found." unless found
+RUBY
