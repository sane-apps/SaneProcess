+    def verify_log_indicates_clean_pass_despite_runner_failure?(text)
+      body = text.to_s
+      has_clean_pass = body.match?(/Swift Testing:\s+\d+ tests .* passed/) ||
+                       body.match?(/Test run with \d+ tests? in \d+ suites? passed/) ||
+                       body.match?(/Test Suite 'All tests' passed/) ||
+                       body.match?(/Executed \d+ tests?, with 0 failures/)
+      return false unless has_clean_pass
+
+      real_failure_markers = [
+        /Test Case '-\[[^\]]+\]' failed/,
+        /✘ Test .* failed/,
+        /Issue recorded:/,
+        /XCTAssert/,
+        /\berror:\s+-\[[^\]]+\]/,
+        /Executed \d+ tests?, with [1-9]\d* failures?/,
+        /Executed \d+ tests?, with \d+ failures?, with [1-9]\d* unexpected/
+      ]
+      real_failure_markers.none? { |pattern| body.match?(pattern) }
+    end
