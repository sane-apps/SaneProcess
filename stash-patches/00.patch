+# A sync of markdown memory files takes seconds. If it is still running after
+# MAX_RUNTIME it is wedged, not working.
+MAX_RUNTIME="${SANE_SYNC_MAX_RUNTIME:-900}"
+STEP_TIMEOUT="${SANE_SYNC_STEP_TIMEOUT:-120}"
