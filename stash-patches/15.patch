+
+  def capture_launch_screenshot_remote
+    timestamp = Time.now.strftime('%Y%m%d-%H%M%S')
+    remote_path = "$HOME/Desktop/Screenshots/sane-test-#{@app_name}-#{timestamp}.png"
+    gui_runner = '~/SaneApps/infra/SaneProcess/scripts/mini/mini-gui-run.sh'
+    capture_script = [
+      'mkdir -p "$HOME/Desktop/Screenshots"',
+      "osascript -e #{Shellwords.escape("tell application \"#{@app_name}\" to activate")} >/dev/null 2>&1 || true",
+      "screencapture -x #{Shellwords.escape(remote_path)}"
+    ].join('; ')
+
+    if ssh_capture("[ -x #{gui_runner} ] && echo yes || echo no").strip == 'yes'
+      ssh("bash #{gui_runner} --title #{Shellwords.escape("#{@app_name} Launch Screenshot")} --log-file /tmp/sane-test-#{@app_name}-screenshot.log --status-file /tmp/sane-test-#{@app_name}-screenshot.status --close-window -- #{Shellwords.escape(capture_script)}")
+    else
+      ssh(capture_script)
+    end
+    warn "   Launch screenshot: mini:#{remote_path}"
+  rescue StandardError => e
+    abort "   ❌ Launch screenshot failed: #{e.message}"
   end
 
