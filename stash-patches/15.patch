+  def capture_launch_screenshot_local
+    screenshots_dir = File.expand_path('~/Desktop/Screenshots')
+    FileUtils.mkdir_p(screenshots_dir)
+    timestamp = Time.now.strftime('%Y%m%d-%H%M%S')
+    screenshot_path = File.join(screenshots_dir, "sane-test-#{@app_name}-#{timestamp}.png")
+    system('osascript', '-e', "tell application \"#{@app_name}\" to activate", out: File::NULL, err: File::NULL)
+    unless system('screencapture', '-x', screenshot_path, out: File::NULL, err: File::NULL)
