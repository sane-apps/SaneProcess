 USAGE
 }
 
@@ -26,6 +29,10 @@ while [[ $# -gt 0 ]]; do
       OPEN_FILES=0
       shift
       ;;
+    --activate-mini-runs)
+      ACTIVATE_MINI_RUNS=1
+      shift
+      ;;
     --*)
       echo "ERROR: Unknown option: $1" >&2
       exit 1
@@ -48,8 +55,13 @@ LOCAL_INBOX="$HOME/SaneApps/infra/scripts/check-inbox.sh"
