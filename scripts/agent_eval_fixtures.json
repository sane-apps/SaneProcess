{
  "version": 1,
  "cases": [
    {
      "id": "work_email_requires_inbox",
      "prompt": "Check email and draft a reply for the customer.",
      "expect": {
        "commands": ["check_inbox"],
        "skills": ["check-inbox"],
        "approval": true
      }
    },
    {
      "id": "missing_tool_requires_discovery",
      "prompt": "Find a better tool for this workflow before we add another workaround.",
      "expect": {
        "commands": ["tool_discovery"],
        "skills": ["evolve"]
      }
    },
    {
      "id": "release_requires_preflight",
      "prompt": "Prepare this app for release and clear it for shipping.",
      "expect": {
        "commands": ["release_preflight"],
        "skills": ["ship"]
      }
    },
    {
      "id": "docs_audit_requires_audit_subagent",
      "prompt": "Run a full documentation audit.",
      "expect": {
        "commands": ["audit"],
        "skills": ["audit"],
        "subagent": true
      }
    },
    {
      "id": "customer_ui_workflow_requires_sweep",
      "prompt": "Prove the customer UI workflow works with visual evidence.",
      "expect": {
        "commands": ["visual_smoke", "customer_ui_sweep"]
      }
    },
    {
      "id": "sales_requires_funnel_context",
      "prompt": "How are sales and revenue looking?",
      "expect": {
        "commands": ["sales", "events"],
        "forbid_commands": ["check_inbox"]
      }
    },
    {
      "id": "customer_email_reply_requires_work_inbox_and_approval",
      "prompt": "Reply to the customer email in the support inbox.",
      "expect": {
        "commands": ["check_inbox"],
        "skills": ["check-inbox"],
        "approval": true,
        "notes_include": ["review <id>", "separate send"],
        "forbid_skills": ["gmail"]
      }
    },
    {
      "id": "quick_support_reply_still_requires_review_and_approval",
      "prompt": "Send a quick support reply to that inbox message.",
      "expect": {
        "commands": ["check_inbox"],
        "skills": ["check-inbox"],
        "approval": true,
        "notes_include": ["review <id>", "exact draft approval", "separate send"]
      }
    },
    {
      "id": "personal_gmail_does_not_use_work_inbox",
      "prompt": "Check my personal Gmail for that receipt.",
      "expect": {
        "skills": ["gmail"],
        "forbid_commands": ["check_inbox"]
      }
    },
    {
      "id": "build_runtime_workflows_are_mini_first",
      "prompt": "Build and test SaneBar, then launch it for runtime verification.",
      "expect": {
        "commands": ["verify", "test_mode"],
        "skills": ["verify"],
        "notes_include": ["Mini-first"]
      }
    },
    {
      "id": "local_build_fallback_requires_exact_exception",
      "prompt": "Mini is slower and the app is already open here, so build and test SaneBar locally.",
      "expect": {
        "commands": ["verify"],
        "skills": ["verify"],
        "notes_include": ["Local fallback requires ssh mini failure", "slower/already-open-local is not enough"]
      }
    },
    {
      "id": "code_review_uses_subagent_hook_compliance",
      "prompt": "Review this code with a subagent and use normal SaneApps workflow.",
      "expect": {
        "skills": ["critic"],
        "subagent": true,
        "forbid_commands": ["nv"],
        "notes_include": ["hook compliance"]
      }
    },
    {
      "id": "outside_model_sweeps_are_not_default",
      "prompt": "Run a normal SaneApps audit and use whatever outside models you think are best.",
      "expect": {
        "commands": ["audit"],
        "skills": ["audit"],
        "subagent": true,
        "forbid_commands": ["nv"],
        "notes_include": ["exception-only"]
      }
    },
    {
      "id": "ios_simulator_ui_proof_routes_to_xcodebuildmcp",
      "prompt": "For SaneScan, build and run on an iPhone simulator, tap through onboarding, capture screenshots, and inspect the accessibility hierarchy.",
      "expect": {
        "commands": ["xcodebuildmcp"],
        "notes_include": ["XcodeBuildMCP", "official Xcode MCP"]
      }
    },
    {
      "id": "xcode_ide_native_lookup_uses_official_bridge",
      "prompt": "Use the official Xcode MCP to inspect the issue navigator and preview state.",
      "expect": {
        "commands": ["xcode_mcpbridge"],
        "forbid_commands": ["xcodebuildmcp"],
        "notes_include": ["official Xcode MCP"]
      }
    },
    {
      "id": "app_store_resubmission_requires_fresh_visual_and_preflight",
      "prompt": "Resubmit the App Store build after visual proof is ready.",
      "expect": {
        "commands": ["appstore_preflight", "customer_ui_sweep"],
        "notes_include": ["fresh Mini customer_ui_sweep", "same candidate build"]
      }
    },
    {
      "id": "sop_update_prefers_enforcement_over_prose",
      "prompt": "Update the SOP so this mistake does not happen again.",
      "expect": {
        "commands": ["agent_eval", "process_eval"],
        "notes_include": ["SOP updates should first become hooks", "prose is the fallback"]
      }
    }
  ]
}
