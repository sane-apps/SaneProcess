{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/Users/stephansmac/SaneApps"
    ],
    "allow": [
      "Bash(./scripts/SaneMaster.rb:*)",
      "Bash(xcodegen:*)",
      "Bash(bundle exec:*)",
      "Bash(killall:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(brew:*)",
      "Bash(swiftlint:*)",
      "Bash(mockolo:*)",
      "Bash(periphery:*)",
      "Bash(lefthook:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(open:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(pgrep:*)",
      "Bash(pkill:*)",
      "Bash(curl:*)",
      "Bash(which:*)",
      "Bash(ruby:*)",
      "Bash(ssh:*)",
      "Bash(/opt/homebrew/opt/ruby/bin/*:*)",
      "mcp__apple-docs__*",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__macos-automator__*",
      "mcp__xcode__*",
      "mcp__XcodeBuildMCP__*",
      "mcp__memory__*"
    ],
    "deny": [
      "Read(//Users/stephansmac/.config/nv/env)",
      "Read(//Users/stephansmac/.private_keys/**)",
      "Read(//Users/stephansmac/.ssh/id_*)",
      "Read(//Users/stephansmac/.aws/credentials)",
      "Read(//Users/stephansmac/.netrc)",
      "Read(//Users/stephansmac/.codex/auth.json)",
      "Read(//Users/stephansmac/.claude/.credentials.json)",
      "Edit(//Users/stephansmac/.config/nv/env)",
      "Edit(//Users/stephansmac/.private_keys/**)",
      "Edit(//Users/stephansmac/.ssh/id_*)",
      "Edit(//Users/stephansmac/.aws/credentials)",
      "Edit(//Users/stephansmac/.netrc)",
      "Edit(//Users/stephansmac/.codex/auth.json)",
      "Edit(//Users/stephansmac/.claude/.credentials.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "allowWrite": [
        "/Users/stephansmac/SaneApps"
      ],
      "denyRead": [
        "~/.config/nv/env",
        "~/.private_keys",
        "~/.ssh/id_*",
        "~/.aws/credentials",
        "~/.netrc",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.config/nv/env",
        "~/.private_keys",
        "~/.ssh/id_*",
        "~/.aws/credentials",
        "~/.netrc",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.config/nv/env", "mode": "deny" },
        { "path": "~/.private_keys", "mode": "deny" },
        { "path": "~/.ssh/id_*", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "api.cloudflare.com",
        "api.github.com",
        "api.lemonsqueezy.com",
        "api.openai.com",
        "api.resend.com",
        "developer.apple.com",
        "github.com",
        "*.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "rubygems.org",
        "mini",
        "*.local"
      ],
      "allowLocalBinding": true
    }
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh session_start.rb",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh saneprompt.rb",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh sane_catastrophic_guard.rb",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh sanetools.rb",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sane_bash_guards.rb",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh sanetrack.rb",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/swift_format.rb || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/mini_build_async.rb || true",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh task_completed_gate.rb",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/SaneApps/infra/SaneProcess/scripts/hooks/run_hook.sh sanestop.rb",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "hookify@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
