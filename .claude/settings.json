{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/SaneApps"
    ],
    "allow": [
      "Bash(./scripts/SaneMaster.rb:*)",
      "Bash(xcodegen:*)",
      "Bash(bundle exec:*)",
      "Bash(killall:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(brew:*)",
      "Bash(swiftlint:*)",
      "Bash(mockolo:*)",
      "Bash(periphery:*)",
      "Bash(lefthook:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(open:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(pgrep:*)",
      "Bash(pkill:*)",
      "Bash(curl:*)",
      "Bash(which:*)",
      "Bash(ruby:*)",
      "Bash(ssh:*)",
      "Bash(/opt/homebrew/opt/ruby/bin/*:*)",
      "mcp__apple-docs__*",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__macos-automator__*",
      "mcp__xcode__*",
      "mcp__XcodeBuildMCP__*"
    ],
    "deny": [
      "Read(~/.config/nv/env)",
      "Read(~/.private_keys/**)",
      "Read(~/.ssh/id_ed25519)",
      "Read(~/.ssh/id_ed25519_github)",
      "Read(~/.ssh/id_rsa)",
      "Read(~/.ssh/id_ecdsa)",
      "Read(~/.ssh/id_dsa)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.config/nv/env)",
      "Edit(~/.private_keys/**)",
      "Edit(~/.ssh/id_ed25519)",
      "Edit(~/.ssh/id_ed25519_github)",
      "Edit(~/.ssh/id_rsa)",
      "Edit(~/.ssh/id_ecdsa)",
      "Edit(~/.ssh/id_dsa)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.codex/auth.json)",
      "Edit(~/.claude/.credentials.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "ssh *",
      "scp *",
      "rsync *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/SaneApps",
        "~/.sanemaster",
        "~/.ssh/known_hosts",
        "~/.ssh/known_hosts.old",
        "/var/folders",
        "/private/var/folders"
      ],
      "denyRead": [
        "~/.config/nv/env",
        "~/.private_keys",
        "~/.ssh/id_ed25519",
        "~/.ssh/id_ed25519_github",
        "~/.ssh/id_rsa",
        "~/.ssh/id_ecdsa",
        "~/.ssh/id_dsa",
        "~/.aws/credentials",
        "~/.netrc",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.config/nv/env",
        "~/.private_keys",
        "~/.ssh/id_ed25519",
        "~/.ssh/id_ed25519_github",
        "~/.ssh/id_rsa",
        "~/.ssh/id_ecdsa",
        "~/.ssh/id_dsa",
        "~/.aws/credentials",
        "~/.netrc",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.config/nv/env", "mode": "deny" },
        { "path": "~/.private_keys", "mode": "deny" },
        { "path": "~/.ssh/id_ed25519", "mode": "deny" },
        { "path": "~/.ssh/id_ed25519_github", "mode": "deny" },
        { "path": "~/.ssh/id_rsa", "mode": "deny" },
        { "path": "~/.ssh/id_ecdsa", "mode": "deny" },
        { "path": "~/.ssh/id_dsa", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ]
    },
    "network": {
      "allowAllUnixSockets": true,
      "allowedDomains": [
        "api.anthropic.com",
        "api.cloudflare.com",
        "api.github.com",
        "api.lemonsqueezy.com",
        "api.openai.com",
        "api.resend.com",
        "developer.apple.com",
        "github.com",
        "*.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "rubygems.org",
        "mini",
        "stephans-mac-mini",
        "stephans-macbook-air",
        "*.ts.net",
        "*.local"
      ],
      "allowLocalBinding": true
    }
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDECODE}${CLAUDE_CODE}\" ] && [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/session_start.rb; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDECODE}${CLAUDE_CODE}\" ] && [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/saneprompt.rb; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sane_catastrophic_guard.rb",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDECODE}${CLAUDE_CODE}\" ] && [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sanetools.rb; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sane_bash_guards.rb",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDECODE}${CLAUDE_CODE}\" ] && [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sanetrack.rb; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/swift_format.rb || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/mini_build_async.rb || true",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/task_completed_gate.rb; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDECODE}${CLAUDE_CODE}\" ] && [ -f .saneprocess ]; then ruby ~/SaneApps/infra/SaneProcess/scripts/hooks/sanestop.rb; fi",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
